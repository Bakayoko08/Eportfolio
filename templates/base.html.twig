<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Eportfolio – Zoumana Bakayoko{% endblock %}</title>

  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --c-orange: #FF6B35;
      --c-teal:   #1B998B;
      --c-bg:     #0f0f13;
      --c-bg2:    #16161c;
      --c-text:   #f0f0f0;
      --c-muted:  rgba(240,240,240,.55);
      --radius:   1.2rem;
      --nav-h:    64px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--c-bg);
      color: var(--c-text);
      overflow-x: hidden;
      padding-top: var(--nav-h);
    }

    /* ── NAVBAR ── */
    .site-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--nav-h);
      z-index: 200;
      background: rgba(15,15,19,0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255,107,53,0.15);
      display: flex;
      align-items: center;
      padding: 0 2rem;
      transition: background .3s;
    }

    .site-nav .container {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-logo {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--c-orange);
      text-decoration: none;
      letter-spacing: .05em;
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: .4rem;
    }
    .nav-toggle span {
      display: block;
      width: 24px; height: 2px;
      background: var(--c-text);
      border-radius: 2px;
      transition: transform .3s, opacity .3s;
    }
    .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-links {
      list-style: none;
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    .nav-links a {
      color: rgba(240,240,240,.7);
      text-decoration: none;
      font-size: .92rem;
      font-weight: 400;
      position: relative;
      padding-bottom: 2px;
      transition: color .2s;
    }
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0;
      width: 0; height: 2px;
      background: var(--c-orange);
      border-radius: 2px;
      transition: width .25s;
    }
    .nav-links a:hover,
    .nav-links a.active { color: var(--c-orange); }
    .nav-links a:hover::after,
    .nav-links a.active::after { width: 100%; }

    .nav-links .nav-cta {
      background: var(--c-orange);
      color: #fff !important;
      padding: .45rem 1.1rem;
      border-radius: .6rem;
      transition: transform .2s, box-shadow .2s !important;
    }
    .nav-links .nav-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255,107,53,.4);
    }
    .nav-links .nav-cta::after { display: none; }

    /* ── MOBILE NAV ── */
    @media (max-width: 768px) {
      .nav-toggle { display: flex; }

      .nav-links {
        position: fixed;
        top: var(--nav-h); left: 0; right: 0;
        background: rgba(15,15,19,0.97);
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 1.5rem 0;
        transform: translateY(-110%);
        opacity: 0;
        transition: transform .35s ease, opacity .3s ease;
        border-bottom: 1px solid rgba(255,107,53,.15);
      }
      .nav-links.open {
        transform: translateY(0);
        opacity: 1;
      }
      .nav-links li { width: 100%; text-align: center; }
      .nav-links a {
        display: block;
        padding: .9rem 2rem;
        font-size: 1rem;
      }
      .nav-links .nav-cta {
        margin: .5rem 2rem 0;
        border-radius: .6rem;
      }
    }

    /* ── FOOTER ── */
    .site-footer {
      background: #090909;
      border-top: 1px solid rgba(255,255,255,.06);
      padding: 2.5rem 2rem;
      text-align: center;
    }
    .footer-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .footer-logo {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.3rem;
      color: var(--c-orange);
    }
    .footer-links {
      list-style: none;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-links a {
      color: var(--c-muted);
      text-decoration: none;
      font-size: .88rem;
      transition: color .2s;
    }
    .footer-links a:hover { color: var(--c-orange); }
    .footer-copy {
      font-size: .82rem;
      color: rgba(240,240,240,.3);
    }
    .footer-copy span { color: var(--c-orange); }
  </style>

  {% block stylesheets %}{% endblock %}
</head>
<body>

  {# ── NAVIGATION ── #}
  <nav class="site-nav">
    <div class="container">
      <a class="nav-logo" href="/blog/Home">ZB.</a>

      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>

      <ul class="nav-links" id="navLinks">
        <li><a href="/blog/Home">Accueil</a></li>
        <li><a href="/blog/Apropos">À propos</a></li>
        <li><a href="/blog/Hobbies">Hobbies</a></li>
        <li><a href="/blog/Contacts" class="nav-cta">Contact</a></li>
      </ul>
    </div>
  </nav>

  {# ── CONTENU DE LA PAGE ── #}
  {% block body %}{% endblock %}

  {# ── FOOTER ── #}
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-logo">ZB.</div>
      <ul class="footer-links">
        <li><a href="/blog/Home">Accueil</a></li>
        <li><a href="/blog/Apropos">À propos</a></li>
        <li><a href="/blog/Hobbies">Hobbies</a></li>
        <li><a href="/blog/Contacts">Contact</a></li>
      </ul>
      <p class="footer-copy">
        &copy; <span id="year"></span> <span>Zoumana Bakayoko</span> — Tous droits réservés.
      </p>
    </div>
  </footer>

  <script>
    // Année dynamique
    document.getElementById('year').textContent = new Date().getFullYear();

    // Menu burger mobile
    const toggle = document.getElementById('navToggle');
    const links  = document.getElementById('navLinks');
    toggle.addEventListener('click', () => {
      toggle.classList.toggle('open');
      links.classList.toggle('open');
    });
    // Fermer le menu au clic sur un lien
    links.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        toggle.classList.remove('open');
        links.classList.remove('open');
      });
    });

    // Lien actif selon l'URL courante
    const path = window.location.pathname;
    links.querySelectorAll('a:not(.nav-cta)').forEach(a => {
      if (a.getAttribute('href') === path) a.classList.add('active');
    });
  </script>

  {% block javascripts %}{% endblock %}
</body>
</html>
