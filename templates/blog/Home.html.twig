{% extends 'base.html.twig' %}

{% block title %}Accueil – Eportfolio Zoumana Bakayoko{% endblock %}

{% block body %}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --c1:#FF6B35;
  --c2:#F7C59F;
  --c3:#1B998B;
  --c4:#2D3047;
  --radius:1.2rem;
}
body{font-family:'DM Sans',sans-serif;background:#0f0f13;color:#f0f0f0;overflow-x:hidden}


/* ── HERO ── */
.hero{
  min-height:90vh;display:flex;align-items:center;
  padding:4rem 2rem;position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-30%;right:-20%;
  width:600px;height:600px;
  background:radial-gradient(circle,rgba(255,107,53,.25) 0%,transparent 70%);
  pointer-events:none;
}
.hero::after{
  content:'';position:absolute;bottom:-20%;left:-10%;
  width:400px;height:400px;
  background:radial-gradient(circle,rgba(27,153,139,.2) 0%,transparent 70%);
  pointer-events:none;
}
.hero-inner{
  max-width:1100px;margin:0 auto;width:100%;
  display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;
}
.hero-tag{
  display:inline-flex;align-items:center;gap:.5rem;
  background:rgba(255,107,53,.15);border:1px solid rgba(255,107,53,.3);
  color:#FF6B35;font-size:.8rem;font-weight:500;
  padding:.4rem .9rem;border-radius:2rem;margin-bottom:1.5rem;
  animation:fadeUp .6s ease both;
}
.hero-tag span{width:8px;height:8px;background:#FF6B35;border-radius:50%;animation:pulse 2s infinite}
h1{
  font-family:'Syne',sans-serif;font-weight:800;
  font-size:clamp(2.2rem,4vw,3.5rem);line-height:1.1;
  margin-bottom:1rem;animation:fadeUp .6s .1s ease both;
}
h1 em{font-style:normal;color:#FF6B35}
.hero-desc{
  color:rgba(240,240,240,.65);font-size:1rem;line-height:1.7;
  margin-bottom:2rem;animation:fadeUp .6s .2s ease both;
}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap;animation:fadeUp .6s .3s ease both}

.btn-primary{
  background:#FF6B35;color:#fff;border:none;
  padding:.85rem 1.8rem;border-radius:.8rem;
  font-family:'DM Sans',sans-serif;font-size:.95rem;font-weight:500;
  cursor:pointer;text-decoration:none;display:inline-block;
  transition:transform .2s,box-shadow .2s;
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(255,107,53,.4)}

.btn-outline{
  background:transparent;color:#f0f0f0;
  border:1px solid rgba(240,240,240,.25);
  padding:.85rem 1.8rem;border-radius:.8rem;
  font-family:'DM Sans',sans-serif;font-size:.95rem;
  cursor:pointer;text-decoration:none;display:inline-block;
  transition:border-color .2s,color .2s;
}
.btn-outline:hover{border-color:#FF6B35;color:#FF6B35}

.hero-visual{display:flex;justify-content:center;animation:fadeIn .8s .2s ease both}
.avatar-wrap{position:relative}
.avatar-ring{
  width:260px;height:260px;border-radius:50%;
  background:linear-gradient(135deg,#FF6B35,#1B998B);padding:4px;
}
.avatar-ring img{
  width:100%;height:100%;border-radius:50%;
  object-fit:cover;display:block;background:#1a1a22;
}
.avatar-badge{
  position:absolute;bottom:12px;right:-8px;
  background:#1B998B;color:#fff;font-size:.75rem;font-weight:500;
  padding:.45rem 1rem;border-radius:2rem;white-space:nowrap;
  border:2px solid #0f0f13;
}
.float-card{
  position:absolute;top:10px;left:-30px;
  background:rgba(255,255,255,.07);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.1);border-radius:.9rem;
  padding:.7rem 1rem;font-size:.8rem;text-align:center;
}
.float-card strong{display:block;font-family:'Syne',sans-serif;font-size:1.3rem;color:#FF6B35}

/* ── STATS ── */
.stats{
  padding:2rem;
  background:rgba(255,255,255,.03);
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.stats-inner{
  max-width:1100px;margin:0 auto;
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:1rem;text-align:center;
}
.stat-num{font-family:'Syne',sans-serif;font-size:2rem;font-weight:700;color:#FF6B35}
.stat-lbl{font-size:.85rem;color:rgba(240,240,240,.5);margin-top:.2rem}

/* ── SECTIONS GÉNÉRALES ── */
.section{padding:5rem 2rem}
.section-inner{max-width:1100px;margin:0 auto}
.section-label{
  font-size:.8rem;text-transform:uppercase;
  letter-spacing:.15em;color:#1B998B;font-weight:500;margin-bottom:.8rem;
}
h2{
  font-family:'Syne',sans-serif;
  font-size:clamp(1.6rem,3vw,2.4rem);
  font-weight:700;margin-bottom:2.5rem;
}

/* ── COMPÉTENCES ── */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}
.skill-card{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:var(--radius);padding:1.5rem;
  transition:border-color .25s,transform .25s;
}
.skill-card:hover{border-color:rgba(255,107,53,.4);transform:translateY(-4px)}
.skill-icon{
  width:44px;height:44px;border-radius:.6rem;
  display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;margin-bottom:1rem;
}
.skill-icon.net{background:rgba(255,107,53,.15)}
.skill-icon.sec{background:rgba(27,153,139,.15)}
.skill-icon.sys{background:rgba(247,197,159,.15)}
.skill-icon.web{background:rgba(99,102,241,.15)}
.skill-card h3{font-family:'Syne',sans-serif;font-size:1rem;font-weight:700;margin-bottom:.5rem}
.skill-card p{font-size:.85rem;color:rgba(240,240,240,.55);line-height:1.5}
.skill-bar{margin-top:1rem;height:4px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
.skill-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,#FF6B35,#F7C59F);transition:width 1s ease}

/* ── PROJETS ── */
.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem}
.project-card{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:var(--radius);overflow:hidden;
  transition:transform .25s,border-color .25s;
}
.project-card:hover{transform:translateY(-6px);border-color:rgba(255,107,53,.3)}
.project-img{
  height:160px;
  background:linear-gradient(135deg,var(--gc1),var(--gc2));
  display:flex;align-items:center;justify-content:center;font-size:3rem;
}
.project-body{padding:1.5rem}
.project-tag{
  display:inline-block;
  background:rgba(27,153,139,.15);color:#1B998B;
  font-size:.75rem;padding:.25rem .7rem;border-radius:2rem;margin-bottom:.7rem;
}
.project-card h3{font-family:'Syne',sans-serif;font-size:1.05rem;font-weight:700;margin-bottom:.5rem}
.project-card p{font-size:.85rem;color:rgba(240,240,240,.55);line-height:1.5}
.project-link{
  display:inline-flex;align-items:center;gap:.3rem;
  color:#FF6B35;font-size:.85rem;font-weight:500;
  margin-top:1rem;text-decoration:none;
}
.project-link::after{content:'→';transition:transform .2s}
.project-link:hover::after{transform:translateX(4px)}



/* ── FOOTER ── */
footer{
  background:#090909;
  border-top:1px solid rgba(255,255,255,.06);
  padding:2rem;text-align:center;
  color:rgba(240,240,240,.35);font-size:.85rem;
}
footer span{color:#FF6B35}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  .hero-inner{grid-template-columns:1fr;gap:2rem;text-align:center}
  .hero-visual{order:-1}
  .avatar-ring{width:180px;height:180px}
  .float-card{display:none}
  .about-grid{grid-template-columns:1fr}
  .stats-inner{grid-template-columns:1fr}
  .nav-links{gap:.8rem}
}
</style>



{# ── HERO ── #}
<header class="hero">
  <div class="hero-inner">
    <div>
      <div class="hero-tag"><span></span> Disponible pour un stage</div>
      <h1>Zoumana<br><em>Bakayoko</em></h1>
      <p class="hero-desc">
        Étudiant en 1ère année de BUT Réseaux &amp; Télécommunications à l'IUT de Roanne.
        Passionné de nouvelles technologies, toujours en quête de nouveaux défis.
      </p>
      <div class="hero-btns">
        <a href="/blog/Compétences" class="btn-primary">Voir mes compétences</a>
        <a href="/blog/Contacts" class="btn-outline">Me contacter</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="avatar-wrap">
        <div class="float-card"><strong>1ère</strong>année BUT</div>
        <div class="avatar-ring">
          <img src="https://oftal.sk/wp-content/uploads/2024/02/siluleta.jpg" alt="Photo de profil">
        </div>
        <div class="avatar-badge">🎓 IUT Roanne</div>
      </div>
    </div>
  </div>
</header>

{# ── STATS ── #}
<div class="stats">
  <div class="stats-inner">
    <div><div class="stat-num">1ère</div><div class="stat-lbl">Année BUT R&T</div></div>
    <div><div class="stat-num">6+</div><div class="stat-lbl">Projets réalisés</div></div>
    <div><div class="stat-num">Roanne</div><div class="stat-lbl">IUT Loire</div></div>
  </div>
</div>

{# ── COMPÉTENCES ── #}
<section class="section">
  <div class="section-inner">
    <div class="section-label">Mes compétences</div>
    <h2>Ce que je maîtrise</h2>
    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-icon net">🌐</div>
        <h3>Réseaux</h3>
        <p>TCP/IP, VLAN, routage, switching, infrastructure réseau</p>
        <div class="skill-bar"><div class="skill-fill" style="width:70%"></div></div>
      </div>
      <div class="skill-card">
        <div class="skill-icon sec">🔒</div>
        <h3>Sécurité</h3>
        <p>Bases de la cybersécurité, pare-feu, protocoles sécurisés</p>
        <div class="skill-bar"><div class="skill-fill" style="width:55%"></div></div>
      </div>
      <div class="skill-card">
        <div class="skill-icon sys">⚙️</div>
        <h3>Systèmes</h3>
        <p>Linux, Windows Server, administration système</p>
        <div class="skill-bar"><div class="skill-fill" style="width:60%"></div></div>
      </div>
      <div class="skill-card">
        <div class="skill-icon web">💻</div>
        <h3>Développement</h3>
        <p>HTML, CSS, PHP, bases du développement web</p>
        <div class="skill-bar"><div class="skill-fill" style="width:65%"></div></div>
      </div>
    </div>
  </div>
</section>

{# ── PROJETS ── #}
<section class="section" style="background:rgba(255,255,255,.02)">
  <div class="section-inner">
    <div class="section-label">Portfolio</div>
    <h2>Projets récents</h2>
    <div class="projects-grid">
      <div class="project-card">
        <div class="project-img" style="--gc1:#1a1a2e;--gc2:#16213e">🌐</div>
        <div class="project-body">
          <span class="project-tag">Réseau</span>
          <h3>Maquette réseau d'entreprise</h3>
          <p>Configuration d'une infrastructure complète avec VLANs, routage inter-VLAN et DHCP.</p>
          <a href="/blog/Projets" class="project-link">Voir le projet</a>
        </div>
      </div>
      <div class="project-card">
        <div class="project-img" style="--gc1:#1a2a1a;--gc2:#0d2b1a">⚙️</div>
        <div class="project-body">
          <span class="project-tag">Système</span>
          <h3>Administration Linux</h3>
          <p>Mise en place d'un serveur Linux avec services SSH, Apache et gestion des utilisateurs.</p>
          <a href="/blog/Projets" class="project-link">Voir le projet</a>
        </div>
      </div>
      <div class="project-card">
        <div class="project-img" style="--gc1:#2a1a1a;--gc2:#2b0d0d">💻</div>
        <div class="project-body">
          <span class="project-tag">Web</span>
          <h3>Eportfolio</h3>
          <p>Conception et développement de ce portfolio avec Symfony, HTML et CSS.</p>
          <a href="/blog/Projets" class="project-link">Voir le projet</a>
        </div>
      </div>
    </div>
  </div>
</section>



{# ── FOOTER ── #}
<footer>
  <p>&copy; <span id="year"></span> <span>Zoumana Bakayoko</span> — Tous droits réservés.</p>
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>

{% endblock %}
